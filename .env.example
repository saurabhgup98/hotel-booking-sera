MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hotel_booking
JWT_SECRET=replace-with-a-long-random-string

# Protects POST/PATCH /api/discount (send it as the x-admin-key header).
DISCOUNT_ADMIN_KEY=replace-with-a-long-random-string

# APTI WhatsApp sending (first room "Book Now" of the day). Empty
# APTI_WHATSAPP_SEND_URL = skipped. APTI_API_KEY is the site's API key —
# the same apk_... key the SDK script uses.
APTI_WHATSAPP_SEND_URL=https://3p7to6mit2.execute-api.ap-south-1.amazonaws.com/dev/whatsapp/site-send
APTI_API_KEY=
APTI_SITE_ID=8e13eea4-1457-440a-a64a-07a9cf809d10
APTI_WHATSAPP_TEMPLATE=room_booking_deduction_update
